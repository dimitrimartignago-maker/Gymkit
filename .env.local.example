# Supabase — copia da Project Settings > API nel tuo progetto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Config palestra (opzionali — hanno fallback in src/config/gym-config.ts)
NEXT_PUBLIC_GYM_NAME=Nome Palestra
NEXT_PUBLIC_GYM_SLUG=nome-palestra
NEXT_PUBLIC_GYM_PRIMARY_COLOR=#1A1A2E
NEXT_PUBLIC_GYM_SECONDARY_COLOR=#FFFFFF
NEXT_PUBLIC_GYM_ACCENT_COLOR=#E94560
NEXT_PUBLIC_GYM_TIMEZONE=Europe/Rome
NEXT_PUBLIC_GYM_CANCELLATION_HOURS=2
